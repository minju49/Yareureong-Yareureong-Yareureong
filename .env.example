# ==========================================
# LLM Voice Kiosk - Environment Variables
# ==========================================

# ---------- AI Service ----------
AI_SERVICE_HOST=localhost
AI_SERVICE_PORT=8000

# 실제 API Key는 .env 파일에만 작성
# GitHub에 실제 키를 절대 업로드하지 말 것
LLM_API_KEY=

# 추후 모델 확정 후 작성
LLM_MODEL=
STT_MODEL=

# ---------- Backend ----------
BACKEND_HOST=localhost
BACKEND_PORT=8080

# ---------- Database ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=voice_kiosk
DB_USERNAME=
DB_PASSWORD=

# ---------- Application ----------
APP_ENV=development
LOG_LEVEL=INFO
